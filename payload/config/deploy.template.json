{
  "$comment": "部署配置模板：字段说明 + 兜底参考。真正的 config/deploy.json 由 deploy.ps1 按当前用户生成。",
  "version": "2.0.0",
  "host": "127.0.0.1",
  "lan": false,
  "ports": {
    "codevault": 57910,
    "eco": 57821,
    "tuner": 57822,
    "errvault": 57911
  },
  "apps": ["codevault", "eco", "tuner", "errvault"],
  "paths": {
    "workspace": "%USERPROFILE%\\AIWorkKit",
    "codeRoots": ["%USERPROFILE%\\AIWorkKit", "%USERPROFILE%\\Desktop"],
    "scriptDir": "%USERPROFILE%\\Desktop\\handdelete",
    "vaultRoot": "%USERPROFILE%\\Desktop\\ScriptVault"
  },
  "rules": ["deploy-target.mdc"],
  "runtime": "%LOCALAPPDATA%\\AIWorkKit\\runtime\\node.exe"
}
